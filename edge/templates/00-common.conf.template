# Docker's embedded DNS. Every upstream below is a `set $upstream ...` so
# nginx resolves it per request and starts even if a project's stack is down.
resolver 127.0.0.11 valid=10s;

# Sign-in endpoints: brute force and credential stuffing target these.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Extension point: vhost files dropped in edge/vhosts.d/ by whatever wants a
# public hostname. Empty by default; an empty glob is fine for nginx.
include /etc/nginx/vhosts.d/*.conf;
