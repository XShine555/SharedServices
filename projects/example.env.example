# Registers one consumer of this stack. A consumer's own deployment supplies
# this file: copy it to projects/<id>.env, where <id> is lowercase letters and
# digits (it becomes the Postgres role and <id>_db, the RabbitMQ user and
# vhost, and the Zitadel service account). No quotes. An empty value means the
# consumer does not get that service.
#
# S3 keys: only A-Z a-z 0-9 _ + / = . - (hex from `openssl rand -hex 24` is fine).
# The consumer's own env file copies these values.

# Postgres role <id> and database <id>_db
DB_PASSWORD=
# RabbitMQ user <id> and vhost <id>
RABBITMQ_PASSWORD=
# S3 identity limited to this bucket (the consumer's own job creates it)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# Zitadel project this id owns, with its own service account and PAT
ZITADEL_PROJECT=
