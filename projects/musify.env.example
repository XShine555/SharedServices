# One project on the shared services. Copy to projects/musify.env (the file
# name is the project id: lowercase letters and digits). No quotes. An empty
# value means the project does not get that service.
#
# S3 keys: only A-Z a-z 0-9 _ + / = . - (hex from `openssl rand -hex 24` is fine).
# The project's own Deploy env file copies these values.

# Postgres role <id> and database <id>_db
DB_PASSWORD=musify
# RabbitMQ user <id> and vhost <id>
RABBITMQ_PASSWORD=musify
# S3 identity limited to this bucket (the project's own job creates it)
S3_ACCESS_KEY=musify_access_key
S3_SECRET_KEY=musify_secret_key
S3_BUCKET=webapi-storage
# Zitadel project this id owns, with its own service account and PAT
ZITADEL_PROJECT=Musify
